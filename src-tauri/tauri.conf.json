{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YaYa",
  "version": "0.1.1",
  "identifier": "com.vanch.yaya",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "压鸭",
        "width": 480,
        "height": 700,
        "minWidth": 440,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "infoplist/en.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "infoplist/zh-Hans.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "infoplist/zh-Hant.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
